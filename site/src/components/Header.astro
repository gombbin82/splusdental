---
import SPlusMark from './SPlusMark.astro';
import { nav, practice } from '../data/practice';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <SPlusMark size={34} />
      <span>{practice.name}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary book" href={practice.links.booking} rel="noopener">
        Book a visit
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu. BaseLayout adds `js` to <html> in the head, which is what hides the nav on small
  // screens; without JavaScript the toggle stays hidden and the nav is always shown.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-nav');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(243 247 247 / 0.96);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 14px;
    border: 2px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    position: relative;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-icon::before {
    top: -6px;
  }

  .menu-icon::after {
    top: 6px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .site-nav ul a {
    display: inline-block;
    padding: 8px 2px;
    color: var(--ink-soft);
    font-weight: 550;
    text-decoration: none;
  }

  .site-nav ul a:hover {
    color: var(--teal-deep);
  }

  .site-nav ul a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--gold);
  }

  .book {
    min-height: 44px;
    padding: 8px 18px;
  }

  @media (max-width: 899px) {
    .site-nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding: 4px 0 20px;
    }

    .site-nav ul {
      flex-direction: column;
    }

    .site-nav ul a {
      display: block;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.1rem;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .site-nav:not([data-open='true']) {
      display: none;
    }
  }
</style>
