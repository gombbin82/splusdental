---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { nav, practice } from '../data/practice';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={40} height={38} densities={[1, 2]} loading="eager" />
      <span>{practice.name}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu. BaseLayout adds `js` to <html>, which is what hides the nav on small screens;
  // without JavaScript the toggle stays hidden and the nav is always shown.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-nav');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--white);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    min-height: 56px;
    padding: 0 var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }

  .brand img {
    width: 40px;
    height: auto;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-nav li + li::before {
    content: '·';
    color: #9e9e9e;
    padding: 0 10px;
  }

  .site-nav a {
    color: #5f5f5f;
    text-decoration: none;
    font-size: 1rem;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    position: relative;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-icon::before {
    top: -7px;
  }

  .menu-icon::after {
    top: 7px;
  }

  @media (max-width: 959px) {
    .site-nav {
      flex-basis: 100%;
      padding-bottom: 12px;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
    }

    .site-nav li + li::before {
      content: none;
    }

    .site-nav a {
      display: block;
      padding: 12px 0;
      border-top: 1px solid #eee;
      font-size: 1.05rem;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .site-nav:not([data-open='true']) {
      display: none;
    }
  }
</style>
