---
import { hours } from '../data/practice';

interface Props {
  /** Visible heading text; omit to hide it (still announced to screen readers). */
  caption?: string;
  align?: 'left' | 'center';
}

const { caption, align = 'left' } = Astro.props;
---

<table class:list={['hours', align]}>
  <caption class:list={{ 'visually-hidden': !caption }}>{caption ?? 'Office hours'}</caption>
  <tbody>
    {
      hours.map((row) => (
        <tr>
          <th scope="row">{row.days}</th>
          <td>{row.hours}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .hours {
    border-collapse: collapse;
  }

  .hours.center {
    margin-inline: auto;
  }

  caption {
    font-weight: 700;
    font-size: var(--step-1);
    padding-bottom: 8px;
  }

  .left caption {
    text-align: left;
  }

  th,
  td {
    padding: 4px 0;
    vertical-align: top;
    font-weight: 400;
  }

  th {
    text-align: left;
    padding-right: 24px;
  }

  td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
