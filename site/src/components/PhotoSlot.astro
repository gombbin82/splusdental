---
/**
 * Reserved space for a real photo the owner will provide (issue #9). Renders a quiet,
 * decorative panel so layouts stay stable. When the photo arrives, put the file in
 * site/src/assets/photos/ and replace this component with Astro's <Image> using real alt text.
 *
 * Find every slot with: grep -rn "<PhotoSlot" site/src
 */
import SPlusMark from './SPlusMark.astro';
import { noindex } from '../lib/env';

interface Props {
  /** Stable slot name, e.g. "dr-kang-headshot". */
  name: string;
  /** What photo belongs here (shown on staging only). */
  description: string;
  /** CSS aspect-ratio, e.g. "4 / 5". */
  ratio?: string;
}

const { name, description, ratio = '4 / 3' } = Astro.props;
---

<div class="photo-slot" data-photo-slot={name} style={`aspect-ratio: ${ratio}`} aria-hidden="true">
  <SPlusMark size={56} class="photo-slot-mark" />
  {noindex && <span class="photo-slot-label">Photo needed: {description}</span>}
</div>

<style>
  .photo-slot {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    border-radius: var(--r-lg);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        rgb(11 94 107 / 0.06) 14px 15px
      ),
      var(--mint);
    overflow: hidden;
  }

  .photo-slot :global(.photo-slot-mark) {
    opacity: 0.35;
  }

  .photo-slot-label {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    background: #fff4dc;
    color: var(--gold-ink);
    border: 1px dashed var(--gold-ink);
    border-radius: var(--r-sm);
    padding: 6px 10px;
    font-size: var(--step--1);
  }
</style>
