---
/**
 * Interim "S+" rank-badge mark (SVG). Placeholder until the owner supplies the real logo file
 * (issue #9). Swap this component's markup for the official logo when it arrives.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;
---

<svg
  class:list={['splus-mark', className]}
  width={size}
  height={Math.round(size * 1.1)}
  viewBox="0 0 120 132"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M60 4 109 30v60c0 6-3 10-8 13L60 128 19 103c-5-3-8-7-8-13V30Z"
    fill="var(--teal, #0b5e6b)"
  ></path>
  <path
    d="M60 14 100 35v54c0 3-1.5 5-4 6.6L60 117 24 95.6c-2.5-1.6-4-3.6-4-6.6V35Z"
    fill="none"
    stroke="rgba(255,255,255,.28)"
    stroke-width="2"></path>
  <text
    x="52"
    y="88"
    text-anchor="middle"
    font-family="'Schibsted Grotesk', system-ui, sans-serif"
    font-weight="800"
    font-size="68"
    fill="#fff">S</text
  >
  <path d="M84 30h8v12h12v8H92v12h-8V50H72v-8h12Z" fill="var(--gold, #e9a93a)"></path>
</svg>
