---
import { addressOneLine, nav, practice } from '../data/practice';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{practice.name}</p>
      <address>
        <a href={practice.links.googleMaps} rel="noopener">{addressOneLine}</a><br />
        <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a> ·
        <a href={`mailto:${practice.email}`}>{practice.email}</a>
      </address>
    </div>
    <nav aria-label="Footer">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="cta">
      <a class="btn btn-light" href={practice.links.booking} rel="noopener">Make an appointment</a>
      <a class="fb" href={practice.links.facebook} rel="noopener">S+ Dental on Facebook</a>
    </div>
  </div>
  <p class="wrap legal">
    © {year} {practice.name} · <a href="/privacy">Privacy policy</a> ·{' '}
    <a href="/terms">Terms of use</a>
  </p>
</footer>

<style>
  .site-footer {
    background: var(--banner);
    color: #e0e0e0;
    padding: 48px 0 24px;
    font-size: var(--step--1);
  }

  .site-footer a {
    color: #fff;
  }

  .grid {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .name {
    font-weight: 700;
    font-size: var(--step-1);
    color: #fff;
    margin-bottom: 8px;
  }

  address {
    font-style: normal;
    line-height: 1.9;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .cta {
    display: grid;
    gap: 16px;
    justify-items: start;
    align-content: start;
  }

  .legal {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    color: #bdbdbd;
  }
</style>
