---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Patient Resources | S+ Dental, Mountlake Terrace"
  fullTitle
  breadcrumb="Patient resources"
  description="Patient resources from S+ Dental in Mountlake Terrace, WA, are coming soon. Call (425) 616-2331 or email info@splus.dental with any questions."
>
  <PageBanner title="Patient resources" />

  <section class="band band-brown center" aria-labelledby="soon-heading">
    <div class="narrow">
      <h2 id="soon-heading">Coming soon!</h2>
      <p>
        Have a question in the meantime? Call us at{' '}
        <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a> or email{' '}
        <a href={`mailto:${practice.email}`}>{practice.email}</a>. New patients can read{' '}
        <a href="/new-patients">what to expect at the first visit</a>.
      </p>
      <div class="actions">
        <a class="btn" href={practice.links.booking} rel="noopener">Make an appointment</a>
      </div>
    </div>
  </section>
</BaseLayout>
