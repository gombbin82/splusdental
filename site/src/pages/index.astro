---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursTable from '../components/HoursTable.astro';
import { mapEmbedUrl, practice, websiteJsonLd } from '../data/practice';
import operatory from '../assets/photos/office-operatory.jpg';
import drKangAtWork from '../assets/photos/dr-kang-at-work.jpg';
import patient from '../assets/photos/dental-patient.jpg';
import forms from '../assets/photos/new-patient-forms.jpg';

const tiles = [
  {
    href: '/about',
    label: 'About us',
    img: drKangAtWork,
    alt: 'Dr. Stephanie Kang treating a patient at S+ Dental',
  },
  {
    href: '/services',
    label: 'Services',
    img: patient,
    alt: 'A smiling patient during a dental cleaning',
  },
  {
    href: '/new-patients',
    label: 'New patients',
    img: forms,
    alt: 'A patient filling out new patient forms',
  },
];
---

<BaseLayout
  title="Dentist in Mountlake Terrace, WA | S+ Dental"
  fullTitle
  description="S+ Dental is a general dentist in Mountlake Terrace, WA, serving the Lynnwood area. Dr. Stephanie Kang, DMD. New patients welcome. Book online today."
  jsonLd={[websiteJsonLd()]}
>
  <section class="hero" aria-labelledby="hero-heading">
    <Image
      class="hero-img"
      src={operatory}
      alt="A treatment room at S+ Dental with a dental chair and equipment"
      widths={[480, 800, 1280, 1536]}
      quality={70}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <h1 id="hero-heading">Welcome to <span>S+ Dental</span></h1>
  </section>

  <section class="band band-brown center" aria-label="Welcome">
    <div class="narrow">
      <a class="btn btn-wide" href={practice.links.booking} rel="noopener">Make an appointment</a>
      <p class="welcome">
        S+ Dental is your neighborhood oral health provider in the Mountlake Terrace and Lynnwood
        area. We strive to provide the utmost care for our patients, and our goal is to help you
        achieve and maintain good oral health for a healthier life.
      </p>
    </div>

    <ul class="wrap tiles">
      {
        tiles.map((t) => (
          <li>
            <Image
              class="photo"
              src={t.img}
              alt={t.alt}
              widths={[300, 400]}
              sizes="(min-width: 900px) 360px, 100vw"
            />
            <a class="btn" href={t.href}>
              {t.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band band-taupe center" aria-labelledby="reviews-heading">
    <div class="narrow">
      <h2 id="reviews-heading">Patient reviews</h2>
      <p>See what our patients say about their visits to S+ Dental on Google.</p>
      <div class="actions">
        <a class="btn" href={practice.links.googleMaps} rel="noopener">Read our Google reviews</a>
      </div>
    </div>
  </section>

  <section class="band band-white" aria-labelledby="location-heading">
    <div class="wrap split visit">
      <iframe
        class="map"
        title="Map showing S+ Dental at 21005 44th Ave W, Mountlake Terrace, WA"
        src={mapEmbedUrl}
        width="560"
        height="420"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="center location">
        <p class="new"><em>Brand-new dental office! We welcome new patients!</em></p>
        <h2 id="location-heading">Location and hours</h2>
        <address>
          {`${practice.address.street} ${practice.address.suite}`}<br />
          {`${practice.address.city}, ${practice.address.region} ${practice.address.postalCode}`}
        </address>
        <HoursTable align="center" />
        <p class="contact">
          <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a><br />
          <a href={`mailto:${practice.email}`}>{practice.email}</a>
        </p>
        <p>
          <a href={practice.links.facebook} rel="noopener">Follow S+ Dental on Facebook</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(300px, 46vw, 560px);
    overflow: hidden;
    background: #d9d5cf;
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.6), rgb(255 255 255 / 0.15));
  }

  .hero h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 var(--gutter);
    text-align: center;
    color: var(--navy);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .hero h1 span {
    display: block;
  }

  .welcome {
    margin-top: 40px;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    line-height: 1.65;
  }

  .tiles {
    list-style: none;
    padding: 0;
    margin-top: 40px;
    margin-bottom: 0;
    display: grid;
    gap: 32px;
  }

  @media (min-width: 760px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }

  .tiles li {
    display: grid;
    gap: 20px;
  }

  .tiles :global(.photo) {
    aspect-ratio: 1;
  }

  .tiles .btn {
    width: 100%;
  }

  .visit {
    align-items: center;
  }

  .map {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border: 0;
    background: var(--taupe);
  }

  .location address {
    font-style: normal;
    margin-bottom: 16px;
  }

  .new {
    font-size: var(--step--1);
  }

  .location h2 {
    color: var(--navy);
    font-style: italic;
  }

  .contact {
    margin-top: 16px;
  }
</style>
