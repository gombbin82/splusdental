---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursTable from '../components/HoursTable.astro';
import SPlusMark from '../components/SPlusMark.astro';
import { addressOneLine, dentistJsonLd, practice, serviceGroups } from '../data/practice';

const allServices = serviceGroups.flatMap((g) => g.services.map((s) => s.name));
---

<BaseLayout
  title="S+ Dental | Dentist in Mountlake Terrace & Lynnwood, WA"
  fullTitle
  description="S+ Dental is a neighborhood general dentistry office in Mountlake Terrace, WA, led by Dr. Stephanie Kang, DMD. Thorough exams, preventive care, crowns, implants, clear aligners and more. New patients welcome."
  jsonLd={[dentistJsonLd()]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="welcome">New patients welcome</p>
        <h1>Thorough, unhurried dental care in Mountlake Terrace.</h1>
        <p class="lead">
          S+ Dental is your neighborhood dental office for Mountlake Terrace and Lynnwood. Dr.
          Stephanie Kang takes the time to explain what's going on with your teeth, so you leave
          understanding your plan and why it matters.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={practice.links.booking} rel="noopener"
            >Make an appointment</a
          >
          <a class="btn btn-secondary" href={`tel:${practice.phone.tel}`}
            >Call {practice.phone.display}</a
          >
        </div>
      </div>

      <figure class="rank">
        <SPlusMark size={220} class="rank-mark" />
        <figcaption>
          <strong>Why “S+”?</strong> In game ranking systems, S+ is the top tier, earned for superb
          performance. It's the standard Dr. Kang sets for every visit.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="visit-heading">
    <div class="wrap split">
      <div>
        <h2 id="visit-heading">Visit us</h2>
        <ul class="facts">
          <li>
            <a href={practice.links.googleMaps} rel="noopener">{addressOneLine}</a>
          </li>
          <li><a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a></li>
          <li><a href={`mailto:${practice.email}`}>{practice.email}</a></li>
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={practice.links.booking} rel="noopener">Book online</a>
          <a class="btn btn-secondary" href="/contact">Directions and map</a>
        </div>
      </div>
      <HoursTable />
    </div>
  </section>

  <section class="band" aria-labelledby="services-heading">
    <div class="wrap split">
      <div>
        <h2 id="services-heading">Care for the whole mouth, in one office</h2>
        <p class="muted">
          From your first comprehensive exam to implants and clear aligners, most care happens
          right here.
        </p>
        <p><a href="/services">See all services</a></p>
      </div>
      <ul class="service-cloud">
        {allServices.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="first-heading">
    <div class="wrap split">
      <div>
        <h2 id="first-heading">Your first visit</h2>
      </div>
      <div>
        <p>
          Your first appointment is a comprehensive exam with x-rays and takes about 1 to 1½ hours.
          Afterward, we'll make a plan tailored to your needs, including the right type of
          cleaning.
        </p>
        <p>
          <a href="/new-patients">What to bring and how to prepare</a>
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="dr-heading">
    <div class="wrap split">
      <div>
        <h2 id="dr-heading">Meet Dr. Stephanie Kang, DMD</h2>
      </div>
      <div>
        <p>
          A Tufts-trained dentist, Dr. Kang spent years caring for patients at community health
          centers and tribal clinics across Washington before opening S+ Dental in June 2023.
        </p>
        <p><a href="/about">About Dr. Kang and S+ Dental</a></p>
        <p>
          Patients tell us they appreciate clear explanations and an unrushed visit. <a
            href="/reviews">Read patient reviews</a
          >
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 48px 0 56px;
    background:
      radial-gradient(60rem 30rem at 100% 0, var(--mint), transparent 70%),
      var(--paper);
  }

  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero {
      padding: 88px 0 96px;
    }

    .hero-grid {
      grid-template-columns: 7fr 4fr;
      gap: 64px;
    }
  }

  .welcome {
    display: inline-block;
    margin-bottom: 20px;
    padding: 4px 12px;
    border-radius: var(--r-sm);
    background: #fff4dc;
    color: var(--gold-ink);
    font-weight: 650;
    font-size: var(--step--1);
  }

  .hero h1 {
    max-width: 14ch;
  }

  .rank {
    margin: 0;
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .rank {
      justify-items: center;
      text-align: center;
    }
  }

  .rank :global(.rank-mark) {
    width: clamp(140px, 36vw, 220px);
    height: auto;
    filter: drop-shadow(0 18px 30px rgb(7 63 72 / 0.22));
  }

  .rank figcaption {
    max-width: 30ch;
    color: var(--ink-soft);
  }

  .rank strong {
    color: var(--ink);
  }

  .service-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .service-cloud li {
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    font-weight: 550;
  }
</style>
