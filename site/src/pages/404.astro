---
import BaseLayout from '../layouts/BaseLayout.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist on the S+ Dental website."
  noindex
>
  <section class="page-head lost">
    <div class="wrap">
      <h1>We couldn't find that page.</h1>
      <p class="lead">
        The link may be out of date. Try the home page, or call us at{' '}
        <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a>.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href={practice.links.booking} rel="noopener"
          >Make an appointment</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 55vh;
  }
</style>
