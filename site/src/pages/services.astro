---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { practice, serviceGroups } from '../data/practice';
---

<BaseLayout
  title="Dental Services in Mountlake Terrace | S+ Dental"
  fullTitle
  breadcrumb="Services"
  withServices
  description="Exams, cleanings, fillings, crowns, root canals, implants, dentures, whitening, clear aligners and 3D x-rays at S+ Dental in Mountlake Terrace, near Lynnwood."
>
  <PageBanner title="Services" />

  <section class="band band-brown" aria-label="Services we offer">
    <div class="wrap groups">
      {
        serviceGroups.map((group, i) => (
          <section aria-labelledby={`group-${i}`}>
            <h2 id={`group-${i}`}>{group.title}</h2>
            <ul>
              {group.services.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="band band-taupe center" aria-labelledby="next-heading">
    <div class="narrow">
      <h2 id="next-heading">Not sure what you need?</h2>
      <p>
        Every new patient starts with a comprehensive exam, and we'll create a plan tailored to
        your needs. <a href="/new-patients">Learn about your first visit</a> or{' '}
        <a href="/contact">contact us</a> with questions.
      </p>
      <div class="actions">
        <a class="btn" href={practice.links.booking} rel="noopener">Make an appointment</a>
        <a class="btn" href={`tel:${practice.phone.tel}`}>Call {practice.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: 36px 64px;
  }

  @media (min-width: 760px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }

  h2 {
    font-size: var(--step-1);
    font-style: italic;
    padding-bottom: 10px;
    border-bottom: 2px solid rgb(255 255 255 / 0.35);
    margin-bottom: 8px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 8px 0;
    font-size: var(--step-1);
  }
</style>
