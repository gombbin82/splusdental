---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursTable from '../components/HoursTable.astro';
import { mapEmbedUrl, practice } from '../data/practice';
---

<BaseLayout
  title="Contact and hours"
  description="S+ Dental, 21005 44th Ave W Ste 103, Mountlake Terrace, WA 98043. Call (425) 616-2331 or email info@splus.dental. Open Tuesday to Friday, Saturday by appointment."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Contact us</h1>
      <p class="lead">
        Call, email or book online. We're in Mountlake Terrace, close to Lynnwood.
      </p>
    </div>
  </header>

  <section class="band band-surface" aria-label="Address, phone and hours">
    <div class="wrap split">
      <div class="details">
        <h2 class="visually-hidden">Address and phone</h2>
        <address>
          <strong>{practice.name}</strong><br />
          {practice.address.street}, {practice.address.suite}<br />
          {practice.address.city}, {practice.address.region}
          {practice.address.postalCode}
        </address>
        <ul class="facts">
          <li>Phone: <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a></li>
          <li>Email: <a href={`mailto:${practice.email}`}>{practice.email}</a></li>
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={practice.links.booking} rel="noopener"
            >Make an appointment</a
          >
          <a class="btn btn-secondary" href={practice.links.googleMaps} rel="noopener"
            >Get directions</a
          >
        </div>
      </div>
      <HoursTable />
    </div>
  </section>

  <section class="band" aria-labelledby="map-heading">
    <div class="wrap">
      <h2 id="map-heading">Map</h2>
      <iframe
        class="map"
        title="Map showing S+ Dental at 21005 44th Ave W, Mountlake Terrace"
        src={mapEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  address {
    font-style: normal;
    font-size: var(--step-1);
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .map {
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 480px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--mint);
  }

  @media (min-width: 800px) {
    .map {
      aspect-ratio: 16 / 7;
    }
  }
</style>
