---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import HoursTable from '../components/HoursTable.astro';
import { practice } from '../data/practice';
import MapEmbed from '../components/MapEmbed.astro';
---

<BaseLayout
  title="Contact & Hours | S+ Dental, Mountlake Terrace WA"
  fullTitle
  breadcrumb="Contact us"
  description="S+ Dental, 21005 44th Ave W Ste 103, Mountlake Terrace, WA 98043. Call (425) 616-2331. Open Tue–Thu 8–5, Fri 7–2, Sat by appointment. Near Lynnwood."
>
  <PageBanner title="Contact us" />

  <section class="band band-brown center" aria-labelledby="details-heading">
    <div class="narrow">
      <h2 id="details-heading" class="visually-hidden">Address, hours and phone</h2>
      <address>
        <strong>{practice.name}</strong><br />
        {`${practice.address.street} ${practice.address.suite}`}<br />
          {`${practice.address.city}, ${practice.address.region} ${practice.address.postalCode}`}
      </address>
      <HoursTable align="center" />
      <p class="contact">
        <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a><br />
        <a href={`mailto:${practice.email}`}>{practice.email}</a>
      </p>
      <div class="actions">
        <a class="btn" href={practice.links.booking} rel="noopener">Make an appointment</a>
        <a class="btn" href={practice.links.googleMaps} rel="noopener">Get directions</a>
      </div>
    </div>
  </section>

  <section class="band band-taupe" aria-labelledby="map-heading">
    <div class="wrap">
      <h2 id="map-heading" class="center">Find us</h2>
      <MapEmbed class="map" />
      <p class="center after-map">
        First visit? Read <a href="/new-patients">what to expect</a> or see{' '}
        <a href="/services">our services</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  address {
    font-style: normal;
    font-size: var(--step-1);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .contact {
    margin-top: 16px;
    font-size: var(--step-1);
  }

  .map {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    max-height: 480px;
    border: 0;
    background: var(--white);
  }

  @media (min-width: 800px) {
    .map {
      aspect-ratio: 16 / 7;
    }
  }

  .after-map {
    margin-top: 20px;
  }
</style>
