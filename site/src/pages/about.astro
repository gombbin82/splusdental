---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { practice } from '../data/practice';
import sign from '../assets/photos/office-sign.jpg';
import drKang from '../assets/photos/dr-kang.jpg';
---

<BaseLayout
  title="About Dr. Stephanie Kang, DMD | S+ Dental"
  fullTitle
  breadcrumb="About us"
  description="Meet Dr. Stephanie Kang, DMD, a Tufts-trained general dentist, and learn what S+ means. S+ Dental opened in Mountlake Terrace, WA, in June 2023."
>
  <PageBanner title="About us" />

  <section class="band band-brown center" aria-labelledby="mission-heading">
    <div class="narrow">
      <h2 id="mission-heading">Mission statement</h2>
      <p class="lead">
        S+ Dental aims to improve the quality of life in our community by providing top-notch,
        customized dental services for our patients. We also hope that everyone who finds value in
        our mission will become an oral health ambassador, sharing the dental knowledge gained from
        visits with us to help improve the lives of others.
      </p>
    </div>
  </section>

  <section class="band band-taupe" aria-labelledby="story-heading">
    <div class="wrap split split-wide-left">
      <div>
        <h2 id="story-heading">What does S+ mean?</h2>
        <p>
          S+ Dental opened in June 2023. Many have wondered what S+ means. It comes from game
          ranking systems, where S+ recognizes superb performance. As an avid gamer, Dr. Stephanie
          Kang always strives to be an S-rank player, and she relates that mastery to real life:
          an S+ dentist.
        </p>
        <p>
          With a vision that everyone who comes to S+ Dental will experience something special,
          above and beyond what they've experienced at dental visits before, Dr. Kang began her
          start-up practice in general dentistry.
        </p>
        <p>
          Our focus is on improving our patients' quality of life by improving their oral health.
          We'll guide you to what you need and want for a healthy smile. Ultimately, we want our
          community to enjoy more quality time with family and friends instead of worrying about
          dental problems.
        </p>
        <p><strong>Come meet us, and let us support your S+ journey to optimal health!</strong></p>
      </div>
      <Image
        class="photo"
        src={sign}
        alt="The S+ Dental logo sign on the office wall"
        widths={[480, 854]}
        sizes="(min-width: 900px) 440px, 100vw"
      />
    </div>
  </section>

  <section class="band band-brown" aria-labelledby="dr-heading">
    <div class="wrap split split-wide-right">
      <Image
        class="photo headshot"
        src={drKang}
        alt="Portrait of Dr. Stephanie Kang, DMD"
        width={237}
        height={261}
      />
      <div>
        <h2 id="dr-heading">{practice.dentist.name}, {practice.dentist.credential}</h2>
        <p>
          Dr. Kang earned her Doctor of Dental Medicine degree from Tufts University School of
          Dental Medicine in Boston, Massachusetts, in 2012. After completing a year of AEGD
          (Advanced Education in General Dentistry) residency through Lutheran Medical Center (now
          NYU Langone Health), she worked in a private dental practice in the Greater Boston area.
        </p>
        <p>
          After visiting Seattle one summer, Dr. Kang fell in love with the city and moved here in
          2015. Since then, she has worked at community health centers and tribal clinics across
          Washington State, providing quality care to underserved communities.
        </p>
        <p>
          Because she enjoys building relationships with patients and coworkers, Dr. Kang has also
          taken locum positions in distant locations, including Barrow, Alaska, and La Push,
          Washington. Caring for so many different communities has given her broad knowledge and
          expertise as a primary dental care provider.
        </p>
        <blockquote>
          “Outside of dentistry, I enjoy spending time with family and friends, playing games,
          drinking boba tea (with 30% sugar or less), watching K-dramas, and challenging myself
          with Chopin's piano études.”
        </blockquote>
        <div class="actions">
          <a class="btn" href={practice.links.booking} rel="noopener">Make an appointment</a>
          <a class="btn" href="/services">Our services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .headshot {
    width: min(100%, 360px);
    margin-inline: auto;
  }

  blockquote {
    margin: 24px 0 0;
    padding-left: 20px;
    border-left: 4px solid var(--taupe);
    font-style: italic;
  }
</style>
