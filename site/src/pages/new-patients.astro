---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="New Patients | Dentist in Mountlake Terrace | S+ Dental"
  fullTitle
  breadcrumb="New patients"
  description="New patients welcome at S+ Dental in Mountlake Terrace, WA. What to expect at your first visit, the new patient packet, and how to prepare. Book online."
>
  <PageBanner title="New patients" />

  <nav class="jump" aria-label="On this page">
    <a href="#first-visit">Your first visit</a>
    <a href="#forms">Forms</a>
    <a href="#financing">Financing</a>
  </nav>

  <section class="band band-brown" id="first-visit" aria-labelledby="first-heading">
    <div class="narrow">
      <h2 id="first-heading">Your first visit</h2>
      <p>
        Here at S+ Dental, we believe in providing very thorough care to help you achieve good
        oral health.
      </p>
      <p>
        During your first visit, we will perform a comprehensive exam, which takes about 1 to 1½
        hours. For the exam we need a set of radiographs (x-rays). If you have recent radiographs
        from another office, please either ask them to forward them to us or give us their
        information at least one week before your appointment. You may need to sign a dental
        records release form.
      </p>
      <p>
        After your exam, we will create a plan tailored to your oral health needs, including the
        type of dental cleaning. Depending on your needs, you may have your cleaning the same day or
        return for another visit.
      </p>
      <p>
        Please send us your insurance information before your appointment so we can verify your
        coverage for the visit.
      </p>
      <p>
        Please arrive at least 15 minutes before your appointment to fill out any necessary
        paperwork.
      </p>
      <div class="actions">
        <a class="btn" href={practice.links.booking} rel="noopener">Make an appointment</a>
        <a class="btn" href="/services">See our services</a>
      </div>
    </div>
  </section>

  <section class="band band-taupe" id="forms" aria-labelledby="forms-heading">
    <div class="narrow">
      <h2 id="forms-heading">Forms</h2>
      <p>Please complete the new patient packet before your first visit.</p>
      <a class="btn" href={practice.links.newPatientPacket} rel="noopener"
        >Download the new patient packet (PDF)</a
      >
    </div>
  </section>

  <section class="band band-brown" id="financing" aria-labelledby="financing-heading">
    <div class="narrow">
      <h2 id="financing-heading">Financing</h2>
      <p>Coming soon!</p>
      <p>
        Questions in the meantime? Call us at{' '}
        <a href={`tel:${practice.phone.tel}`}>{practice.phone.display}</a> or email{' '}
        <a href={`mailto:${practice.email}`}>{practice.email}</a>, or see our{' '}
        <a href="/contact">location and hours</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    padding: 14px var(--gutter);
    background: var(--taupe);
  }

  .jump a {
    color: var(--navy);
    font-weight: 700;
  }

  [id] {
    scroll-margin-top: 72px;
  }
</style>
