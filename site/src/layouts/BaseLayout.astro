---
import '../styles/global.css';
import '@fontsource/merriweather/latin-400.css';
import '@fontsource/merriweather/latin-700.css';
import '@fontsource/merriweather/latin-700-italic.css';
import fontUrl from '@fontsource/merriweather/files/merriweather-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { SITE_URL, breadcrumbJsonLd, dentistJsonLd, practice } from '../data/practice';
import { gaId, noindex as noindexBuild } from '../lib/env';

interface Props {
  /** Page title; " | S+ Dental" is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  /** Use `title` as-is (home page). */
  fullTitle?: boolean;
  /** Exclude this page from search engines regardless of environment (e.g. /thank-you). */
  noindex?: boolean;
  /** Extra structured data objects rendered as JSON-LD (the Dentist node is always included). */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb label for subpages; adds a BreadcrumbList (Home > label). */
  breadcrumb?: string;
  /** List the services as offers in the Dentist JSON-LD (/services). */
  withServices?: boolean;
}

const {
  title,
  description,
  fullTitle = false,
  noindex = false,
  jsonLd = [],
  breadcrumb,
  withServices = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${practice.name}`;
const path = Astro.url.pathname.replace(/\/$/, '');
const canonical = `${SITE_URL}${path || '/'}`;
const robotsNoindex = noindexBuild || noindex;
// No analytics on pages excluded from search (payment return, 404) or on non-prod builds.
const analytics = gaId && !noindex ? gaId : '';
const ogImage = `${SITE_URL}/og-image.png`;
const structuredData = noindex
  ? []
  : [
      dentistJsonLd({ withServices }),
      ...(breadcrumb ? [breadcrumbJsonLd(breadcrumb, path)] : []),
      ...jsonLd,
    ];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#635952" />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="S+ Dental, general dentistry in Mountlake Terrace, Washington"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {
      structuredData.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {analytics && <AnalyticsConsent gaId={analytics} />}
  </body>
</html>
