---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, practice } from '../data/practice';
import { noindex as noindexBuild } from '../lib/env';

interface Props {
  /** Page title; " | S+ Dental" is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  /** Use `title` as-is (home page). */
  fullTitle?: boolean;
  /** Exclude this page from search engines regardless of environment (e.g. /thank-you). */
  noindex?: boolean;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, fullTitle = false, noindex = false, jsonLd = [] } = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${practice.name}`;
const path = Astro.url.pathname.replace(/\/$/, '');
const canonical = `${SITE_URL}${path || '/'}`;
const robotsNoindex = noindexBuild || noindex;

const fontFace = `@font-face{font-family:'Schibsted Grotesk';font-style:normal;font-display:swap;font-weight:400 900;src:url(${fontUrl}) format('woff2-variations'),url(${fontUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b5e6b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
