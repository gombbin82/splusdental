---
import AppShell from '../layouts/AppShell.astro';
import Icon from '../components/Icon.astro';
---

<AppShell title="Home" current="home">
  <header class="page-head">
    <div>
      <h1>Welcome<span data-first-name></span></h1>
      <p class="page-sub" id="today"></p>
    </div>
  </header>

  <div class="home-grid">
    <a class="card action-card" href="/payment-links#new">
      <span class="action-icon"><Icon name="add" size={24} /></span>
      <span>
        <span class="action-title">Create a payment link</span>
        <span class="action-text">Send a patient a secure Stripe link for a balance.</span>
      </span>
    </a>
    <a class="card action-card" href="https://splus.dental" target="_blank" rel="noopener">
      <span class="action-icon"><Icon name="open_in_new" size={22} /></span>
      <span>
        <span class="action-title">Open the website</span>
        <span class="action-text">See splus.dental the way patients do.</span>
      </span>
    </a>
    <a class="card action-card" href="/settings" data-admin hidden>
      <span class="action-icon"><Icon name="settings" size={22} /></span>
      <span>
        <span class="action-title">Settings</span>
        <span class="action-text">Environment, Stripe mode, and who has access.</span>
      </span>
    </a>
  </div>

  <section class="card table-card" aria-labelledby="recent-heading">
    <div class="card-head">
      <h2 id="recent-heading">Recent payment links</h2>
      <a class="btn btn-text" href="/payment-links">View all</a>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Created</th>
            <th scope="col" class="desc">Description</th>
            <th scope="col" class="num">Amount</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody id="links-body">
          <tr><td colspan="5" class="empty-row">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</AppShell>

<script>
  import { $, onReady } from '../app/shell';
  import { LinksTable } from '../app/payment-links';

  $('today').textContent = new Intl.DateTimeFormat('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
  }).format(new Date());

  onReady(() => new LinksTable($('links-body'), { limit: 5, compact: true, columns: 5 }).load());
</script>
