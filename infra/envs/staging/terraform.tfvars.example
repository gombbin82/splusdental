# Copy to terraform.tfvars (git-ignored) and fill in.
# Who can sign in to the staff admin (admin-staging.splus.dental) (exact Google account emails; anyone else gets 403).
# Admins: full access (settings, reports). Staff: payment links. Re-run apply after editing.
admin_emails = ["owner@example.com"]
staff_emails = ["frontdesk@example.com"]

oauth_client_id = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# hosting_site_id = "splus-dental-staging"

# Flip to true after: gcloud secrets versions add splus-web-staging-stripe-secret-key --data-file=-
enable_service = false

# Leave false until the DNS plan in issue #10 is agreed.
enable_custom_domains = false

# Staff admin host. Set true, apply, then add the `admin_domain_dns_updates` output records in
# Squarespace DNS (only the new admin-staging host records; never touch MX / Workspace records).
enable_admin_domain = false
# admin_hosting_site_id = "splus-dental-admin-staging"

# Email payment links from this Workspace mailbox (Gmail API via domain-wide delegation; see
# infra/README.md "Email"). Leave empty to turn emailing off.
gmail_sender = "info@example.com"

# Admin "Website traffic" page: numeric GA4 property ID (GA → Admin → Property details), not the
# G-… measurement ID. The runtime SA must be a Viewer on the property (infra/README.md "Website
# analytics"). Leave empty to turn the page off. Staging can read the prod property.
ga4_property_id = ""

# Postgres on the shared Cloud SQL instance (apply infra/shared first). Then add the seed secret
# version and set enable_seed = true (infra/README.md → Database).
enable_database = false
enable_seed     = false
