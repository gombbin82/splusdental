# Local dev: copy to .env and run `node --env-file=.env` / `pnpm dev:api`. Never commit real values.
# On Cloud Run these are set by Terraform (infra/); STRIPE_SECRET_KEY comes from Secret Manager.

# dev | staging | prod — shown in the admin banner; live Stripe keys are refused outside prod.
APP_ENV=dev
PORT=8080
# OAuth 2.0 Web client ID used to verify staff Google ID tokens (public value, not a secret).
GOOGLE_OAUTH_CLIENT_ID=
# Allowed Google Workspace domain for admin sign-in (checked against the token's `hd` claim).
# Comma-separated Google account emails. Admins: everything; staff: payment links. Others get 403.
ADMIN_EMAILS=
STAFF_EMAILS=
# Stripe TEST secret key for local dev (sk_test_... or a restricted rk_test_...).
STRIPE_SECRET_KEY=
# Public base URL used for the Payment Link redirect (<url>/thank-you).
PUBLIC_SITE_URL=http://localhost:4321
# Mailbox payment-link emails are sent as (Gmail API via domain-wide delegation). Empty = email off.
# Locally this needs ADC for an SA with signJwt rights; usually leave empty in dev.
GMAIL_SENDER=
