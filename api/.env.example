# Copy to .env for local dev. Never commit real values.
PORT=8080
# OAuth 2.0 Web client ID used to verify staff Google ID tokens (public value).
GOOGLE_OAUTH_CLIENT_ID=
# Allowed Google Workspace domain for admin sign-in.
ADMIN_HD=splus.dental
# Stripe TEST secret key for local dev (sk_test_...). Prod/staging read from Secret Manager.
STRIPE_SECRET_KEY=
# Public base URL used for Payment Link redirects.
PUBLIC_SITE_URL=http://localhost:4321
